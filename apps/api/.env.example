# ---- Base de données / cache -------------------------------------------------
DATABASE_URL=postgresql://relais:relais@localhost:5432/relais
REDIS_URL=redis://localhost:6379

# ---- Authentification (Backend Specs §8) -------------------------------------
# 256 bits aléatoires, distincts entre eux. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_STEPUP_SECRET=change-me-stepup
JWT_ACCESS_EXPIRY=15m
JWT_STEPUP_EXPIRY=5m
# Durée des sessions (refresh token), en jours — security.session_months = 3
SESSION_DAYS=90
# Secret HMAC pour hacher refresh tokens et OTP avant stockage
TOKEN_HMAC_SECRET=change-me-hmac

# ---- relais_x25519_sk (DEC-15 / DEC-28 / DEC-30, Backend v1.1 §9.1) ----------
# Clé privée X25519 de Relais, 32 bytes hex : `openssl rand -hex 32`
# Ouvre les notification_enc (crypto_box_seal) des trusted contacts.
# Dev/test seulement — interdite en production :
RELAIS_X25519_SK_DEV=
# Production : HashiCorp Vault, KV v2, le seul usage de HCV. Obligatoire.
#   vault kv put secret/relais/x25519_sk x25519_sk=<hex>
#HCV_ADDR=https://vault.example.com
#HCV_TOKEN=hvs.XXXXX
#HCV_SECRET_PATH=secret/data/relais/x25519_sk
#HCV_SECRET_FIELD=x25519_sk

# ---- Stockage objet (Backend Specs §5.2) -------------------------------------
# memory | fs | s3   (s3 = Storj, S3-compatible)
STORAGE_BACKEND=fs
STORAGE_FS_DIR=.storage
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_ACCESS_KEY=
STORJ_SECRET_KEY=
STORJ_BUCKET=relais-payloads

# ---- Email -------------------------------------------------------------------
# console | resend
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=Relais <noreply@relais.app>
EMAIL_REPLY_TO=support@relais.app

# ---- Push (OneSignal, lot 5 mobile) -------------------------------------------
# console | onesignal — la clé REST ne vit qu'ici (DEC-18) ; l'utilisateur est
# ciblé par external_id = SHA256(user_id), jamais par son email.
PUSH_TRANSPORT=console
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Jobs (Backend Specs §4) ---------------------------------------------------
# true : ce processus exécute aussi le worker BullMQ (deadman:checkin, 09:00 UTC)
JOBS_ENABLED=false
