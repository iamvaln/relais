# ---- Base de données / cache -------------------------------------------------
DATABASE_URL=postgresql://relais:relais@localhost:5432/relais
REDIS_URL=redis://localhost:6379

# ---- Authentification (Backend Specs §8) -------------------------------------
# 256 bits aléatoires, distincts entre eux. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_STEPUP_SECRET=change-me-stepup
JWT_ACCESS_EXPIRY=15m
JWT_STEPUP_EXPIRY=5m
# Durée des sessions (refresh token), en jours — security.session_months = 3
SESSION_DAYS=90
# Secret HMAC pour hacher refresh tokens et OTP avant stockage
TOKEN_HMAC_SECRET=change-me-hmac

# ---- relais_x25519_sk (DEC-28 / DEC-30) --------------------------------------
# Clé privée X25519 de Relais, 32 bytes hex : `openssl rand -hex 32`
# Ouvre les notification_enc (crypto_box_seal) des trusted contacts.
# En production : HCV Secrets Engine (relais/x25519_sk). Ici : variable d'env.
RELAIS_X25519_SK=

# ---- Stockage objet (Backend Specs §5.2) -------------------------------------
# memory | fs | s3   (s3 = Storj, S3-compatible)
STORAGE_BACKEND=fs
STORAGE_FS_DIR=.storage
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_ACCESS_KEY=
STORJ_SECRET_KEY=
STORJ_BUCKET=relais-payloads

# ---- Email -------------------------------------------------------------------
# console | resend
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=Relais <noreply@relais.app>
EMAIL_REPLY_TO=support@relais.app

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
