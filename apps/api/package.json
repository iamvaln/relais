{
  "name": "@relais/api",
  "private": true,
  "version": "0.1.0",
  "description": "Relais — API backend (Fastify)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "pretypecheck": "npm --prefix ../.. run core:build",
    "pretest": "npm --prefix ../.. run core:build"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.0",
    "bullmq": "^6.3.4",
    "fastify": "^5.6.0",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "libsodium-wrappers": "^0.7.16",
    "otpauth": "^9.4.0",
    "pino": "^9.14.0",
    "resend": "^4.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@relais/admin-core": "0.1.0",
    "@relais/api-client": "0.1.0",
    "@relais/app-core": "0.1.0",
    "@relais/crypto-core": "0.1.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
