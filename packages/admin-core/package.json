{
  "name": "@relais/admin-core",
  "private": true,
  "version": "0.1.0",
  "description": "Relais — logique du back office sans React : client de l'API /admin (jeton 8 h, jamais de refresh), session, grille des rôles, tableau de bord, utilisateurs, transmissions, questions, configuration. Branche api-client.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@relais/api-client": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
