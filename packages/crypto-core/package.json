{
  "name": "@relais/crypto-core",
  "private": true,
  "version": "0.1.0",
  "description": "Relais — cœur cryptographique côté device : seed, clés, coffre, parts Shamir, contacts, relay, carnet. Ni UI, ni stockage, ni réseau.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
