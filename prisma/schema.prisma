/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String                      @unique
  phone                     String?
  full_name                 String
  password_hash             String
  language                  String                      @default("fr")
  ed25519_pk                Bytes?                      @unique
  email_verified            Boolean                     @default(false)
  account_status            String                      @default("pending_verification")
  plan                      String                      @default("free")
  totp_secret               String?
  totp_enabled              Boolean                     @default(false)
  login_fail_count          Int                         @default(0)
  login_locked_until        DateTime?                   @db.Timestamptz(6)
  otp_fail_count            Int                         @default(0)
  otp_locked_until          DateTime?                   @db.Timestamptz(6)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  deleted_at                DateTime?                   @db.Timestamptz(6)
  deleted_by                String?
  deleted_by_admin          String?                     @db.Uuid
  deletion_reason           String?
  annual_wrappeds           annual_wrappeds[]
  checkin_log               checkin_log[]
  checkin_relances          checkin_relances[]
  email_log                 email_log[]
  email_otp                 email_otp[]
  journal_entries           journal_entries[]
  payment_events            payment_events[]
  push_tokens               push_tokens[]
  restore_challenges        restore_challenges[]
  sessions                  sessions[]
  subscriptions             subscriptions?
  support_tickets           support_tickets[]
  transmission_configs      transmission_configs?
  transmissions             transmissions[]
  trusted_contacts          trusted_contacts[]
  two_factor_recovery_codes two_factor_recovery_codes[]
  admin_users               admin_users?                @relation(fields: [deleted_by_admin], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
}

model two_factor_recovery_codes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  code_hash  String    @db.Char(64)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, code_hash], map: "uq_user_code")
}
